# Environment variables for AssetFlow Pro
# Copy this file to .env and fill in the values

# Flask / Backend
SECRET_KEY=change-me-generate-a-secure-random-key
FLASK_DEBUG=0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://assetflow.localhost,http://assetflow.192.168.3.11.nip.io

# ==== IA & Integrações (Google Gemini) ====
GEMINI_API_KEY=sua_chave_do_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# ==== Notificações Externas (Opcional - Telegram Bot) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend & Gateway
# O middleware do Next valida o cookie de sessao com o mesmo SECRET_KEY acima.
BACKEND_URL=http://backend:5328
NEXT_PUBLIC_API_URL=
# Defina true apenas quando publicado via HTTPS; em HTTP local/LAN mantenha false
COOKIE_SECURE=false
WATCHPACK_POLLING=true
